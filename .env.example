# Required. Get one at https://console.anthropic.com/settings/keys
# This is read only on the server. It is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-sonnet-4-5
# AI_FAST_MODEL=claude-haiku-4-5
# AI_MAX_TOKENS=4096
# AI_TIMEOUT_MS=120000
# AI_MAX_TOOL_ITERATIONS=6

# Rate limiting (per client, in-memory by default)
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=500

# Set to true once you wire a real AuthAdapter in src/lib/core/auth.ts
# AUTH_REQUIRED=false

# Required. Get a free key at https://console.groq.com/keys
# This is read only on the server. It is never sent to the browser.
GROQ_API_KEY=gsk_...

# Optional. Groq retires model IDs periodically. The defaults below are the
# current tool-calling production models -- leave these commented out and you
# get them automatically.
#
# If you see "does not have the model ..." the ID you set has been retired.
# Open /api/diag on the deployment: it lists every model your key can actually
# use right now. (llama-3.1-8b-instant and llama-3.3-70b-versatile were retired
# in June 2026; gpt-oss-20b and gpt-oss-120b are their replacements.)
#
# The main model MUST support tool calling, or the math engine is bypassed.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# AI_MAX_TOKENS=4096
# AI_TIMEOUT_MS=50000   (keep below your Vercel function limit)
# AI_MAX_TOOL_ITERATIONS=4

# Rate limiting (per client, in-memory by default)
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=500

# Set to true once you wire a real AuthAdapter in src/lib/core/auth.ts
# AUTH_REQUIRED=false

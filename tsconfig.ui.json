{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["types/ui-shims.d.ts", "types/node-shim.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
